{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "luma-okey-room-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomSession" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomSession"] }
  ]
}
