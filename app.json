{
  "expo": {
    "name": "Luma Okey",
    "slug": "luma-okey",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "lumaokey",
    "icon": "./assets/game/app-icon-dev.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alparslankopruluu.lumaokey",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Luma Okey uses the microphone only while you hold push-to-talk in a voice-enabled room. Voice is not recorded by the app."
      }
    },
    "android": {
      "package": "com.alparslankopruluu.lumaokey",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/game/app-icon-dev.png",
        "backgroundColor": "#0A1028"
      }
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": "Luma Okey uses the microphone only while you hold push-to-talk. Voice is not recorded by the app."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "featureFlags": {
        "onlineRooms": false,
        "voice": false,
        "store": false,
        "chipRooms": false
      }
    }
  }
}
